                <div>
                    <h3 class="text-sm/6 font-semibold text-white">Services</h3>
                    <ul role="list" class="mt-6 space-y-4">
                        <li>
                            <a href="/services.html#cloud_consulting" class="text-sm/6 text-gray-400 hover:text-gray-300">Cloud Consulting</a>
                        </li>
                        <li>
                            <a href="/services.html#cloud_security" class="text-sm/6 text-gray-400 hover:text-gray-300">Cloud Security</a>
                        </li>
                        <li>
                            <a href="/services.html#cloud_migration_and_optimization" class="text-sm/6 text-gray-400 hover:text-gray-300">Cloud Migration &amp; Cost Optimization</a>
                        </li>
                        <li>
                            <a href="/services.html#threat_modelling" class="text-sm/6 text-gray-400 hover:text-gray-300">Threat Modeling</a>
                        </li>
                        <li>
                            <a href="/services.html#devsecops" class="text-sm/6 text-gray-400 hover:text-gray-300">DevSecOps / DevOps</a>
                        </li>
                        <li>
                            <a href="/services.html#kubernetes" class="text-sm/6 text-gray-400 hover:text-gray-300">Kubernetes</a>
                        </li>
                    </ul>
                </div>
                
                <!-- Company -->
                <div>
                    <h3 class="text-sm/6 font-semibold text-white">Company</h3>
                    <ul role="list" class="mt-6 space-y-4">
