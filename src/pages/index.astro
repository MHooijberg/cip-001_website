                        </dd>
                    </div>
                    <!-- Threat Modeling -->
                    <div class="relative pl-9 max-w-sm w-full sm:w-1/2 lg:w-1/3">
                        <dt class="inline font-semibold text-white">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="absolute top-1 left-1 size-6 text-brand-primary">
                                <path d="M13.5 16.875h3.375m0 0h3.375m-3.375 0V13.5m0 3.375v3.375M6 10.5h2.25a2.25 2.25 0 0 0 2.25-2.25V6a2.25 2.25 0 0 0-2.25-2.25H6A2.25 2.25 0 0 0 3.75 6v2.25A2.25 2.25 0 0 0 6 10.5Zm0 9.75h2.25A2.25 2.25 0 0 0 10.5 18v-2.25a2.25 2.25 0 0 0-2.25-2.25H6a2.25 2.25 0 0 0-2.25 2.25V18A2.25 2.25 0 0 0 6 20.25Zm9.75-9.75H18a2.25 2.25 0 0 0 2.25-2.25V6A2.25 2.25 0 0 0 18 3.75h-2.25A2.25 2.25 0 0 0 13.5 6v2.25a2.25 2.25 0 0 0 2.25 2.25Z" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                            Threat Modeling
                        </dt>
                        <dd class="inline">
                            Proactive threat modeling to uncover and prioritize risks—integrated into your development lifecycle for continuous protection.
                        </dd>
                    </div>
                    <!-- DevSecOps / DevOps -->
                    <div class="relative pl-9 max-w-sm  w-full sm:w-1/2 lg:w-1/3">
                        <dt class="inline font-semibold text-white">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.5" data-slot="icon" aria-hidden="true" class="absolute top-1 left-1 size-6 text-brand-primary">
