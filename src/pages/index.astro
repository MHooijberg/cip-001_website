---
import "../scripts/main.js";
import Layout from '../layouts/Layout.astro';

import { Image } from 'astro:assets';
import AwsLogo from "../images/Amazon_Web_Services_Logo.svg";
import GcpLogo from "../images/Google_Cloud_icon.svg";
import AzureLogo from "../images/Microsoft_Azure.svg";
import PortraitEmma from "../images/emma.jpg";
import PortraitMichael from "../images/michael.jpg";
import PortraitFloyd from "../images/Floyd.jpg";
---

<Layout title="Home">
    <!-- Welcome Section -->
    <section id="welcome">
        <div class="relative isolate px-6 pt-14 lg:px-8">
            <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80">
                <div style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)" class="relative left-[calc(50%-11rem)] aspect-1155/678 w-144.5 -translate-x-1/2 rotate-30 bg-linear-to-tr from-[var(--color-brand-primary-gradient-from)] to-[var(--color-brand-primary-gradient-to)] opacity-30 sm:left-[calc(50%-30rem)] sm:w-288.75"></div>
            </div>
            <div class="mx-auto max-w-2xl py-20 sm:py-24 lg:py-28">
                <div class="hidden sm:mb-8 sm:flex sm:justify-center">
                    <div class="relative rounded-full px-3 py-1 text-sm/6 text-gray-400 ring-1 ring-white/10 hover:ring-white/20">
                        Trusted by organizations for cyber security expertise. <a href="/company.html" class="font-semibold text-brand-primary"><span aria-hidden="true" class="absolute inset-0"></span>Read more <span aria-hidden="true">&rarr;</span></a>
                    </div>
                </div>
                <div class="text-center">
                    <h1 class="text-5xl font-semibold tracking-tight text-balance text-white sm:text-7xl">NoxSecurity - Cyber Security Consultancy </h1>
                    <p class="mt-8 text-lg font-medium text-pretty text-gray-400 sm:text-xl/8">Safeguarding your cloud, infrastructure, and supply chain. Our team of seasoned experts delivers tailored security solutions for modern organizations.</p>
                    <div class="mt-10 flex items-center justify-center gap-x-6">
                        <a href="/services.html" class="rounded-md bg-brand-primary px-3.5 py-2.5 text-sm font-semibold text-brand-on-primary shadow-xs hover:bg-brand-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-outline">Our Services</a>
                        <a href="/company.html" class="text-sm/6 font-semibold text-white">Learn more about us <span aria-hidden="true">&rarr;</span></a>
                    </div>
                </div>
                <div class="py-12 sm:py-18">
                    <div class="mx-auto max-w-7xl px-6 lg:px-8">
                        <h2 class="text-center text-lg/8 font-semibold text-white">Our services support all major cloud platforms</h2>
                        <div class="mx-auto mt-10 grid max-w-lg grid-cols-4 items-center justify-center gap-x-8 gap-y-10 sm:max-w-xl sm:grid-cols-6 sm:gap-x-10 lg:mx-0 lg:max-w-none lg:grid-cols-3">
                            <Image src={AwsLogo} alt="Amazon Web Services" class="col-span-2 max-h-12 w-full object-contain lg:col-span-1" />
                            <Image src={GcpLogo} alt="Google Cloud" class="col-span-2 max-h-12 w-full object-contain lg:col-span-1" />
                            <Image src={AzureLogo} alt="Microsoft Azure" class="col-span-2 max-h-12 w-full object-contain lg:col-span-1" />
                        </div>
                    </div>
                </div>
            </div>
            <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]">
                <div style="clip-path: polygon(28% 58%, 0% 40%, 5% 72%, 16% 100%, 21% 97%, 29% 67%, 40% 37%, 47% 31%, 52% 41%, 55% 65%, 71% 23%, 99% 35%, 82% 0%, 73% 23%, 26% 5%, 28% 58%)" class="relative left-[calc(50%+3rem)] aspect-1155/678 w-144.5 -translate-x-1/2 bg-linear-to-tr from-[var(--color-brand-primary-gradient-from)] to-[var(--color-brand-primary-gradient-to)] opacity-30 sm:left-[calc(50%+36rem)] sm:w-288.75"></div>
            </div>
        </div>
    </section>
    
    <!-- divider -->
    <div class="mx-auto max-w-7xl px-6">
        <div class="flex items-center justify-center py-8">
            <span class="block h-px w-2/3 bg-gray-700"></span>
        </div>
    </div>
    
    <!-- Services Section -->
    <section id="services">
        <div class="py-24 sm:py-32">
            <div class="mx-auto max-w-7xl px-6 lg:px-8">
                <div class="mx-auto max-w-2xl sm:text-center">
                    <h2 class="text-base/7 font-semibold text-brand-primary">Our Services</h2>
                    <p class="mt-2 text-4xl font-semibold tracking-tight text-pretty text-white sm:text-5xl sm:text-balance">
                        Secure Your Cloud, Secure Your Future
                    </p>
                    <p class="mt-6 text-lg/8 text-gray-300">
                        Nox delivers expert cyber security services for organizations running on all major cloud platforms. Our team helps you stay ahead of threats, meet compliance, and build resilient infrastructure.
                    </p>
                </div>
            </div>
            <div class="relative overflow-hidden pt-16">
                <div class="mx-auto max-w-7xl px-6 lg:px-8">
                    <img width="2432" height="1442" src="https://tailwindcss.com/plus-assets/img/component-images/dark-project-app-screenshot.png" alt="App screenshot" class="mb-[-12%] rounded-xl shadow-2xl ring-1 ring-white/10" />
                    <div aria-hidden="true" class="relative">
                        <div class="absolute -inset-x-20 bottom-0 bg-linear-to-t from-gray-900 pt-[7%]"></div>
                    </div>
                </div>
            </div>
            <div class="mx-auto mt-16 max-w-7xl px-6 sm:mt-20 md:mt-24 lg:px-8">
                <dl class="mx-auto flex flex-wrap justify-center max-w-2xl gap-x-6 gap-y-10 text-base/7 text-gray-400 lg:mx-0 lg:max-w-none lg:gap-x-8 lg:gap-y-16">
                    <!-- Cloud Consulting -->
                    <div class="relative pl-9 max-w-sm w-full sm:w-1/2 lg:w-1/3">
                        <dt class="inline font-semibold text-white">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.5" data-slot="icon" aria-hidden="true" class="absolute top-1 left-1 size-6 text-brand-primary">
