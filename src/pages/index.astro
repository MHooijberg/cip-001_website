2.31 17.69,11.75 17,11.75 C16.31,11.75 15.75,12.31 15.75,13 Z M8,2.75 C7.31,2.75 6.75,3.31 6.75,4 C6.75,4.69 7.31,5.25 8,5.25 C8.69,5.25 9.25,4.69 9.25,4 C9.25,3.31 8.69,2.75 8,2.75 Z"/>
                            </svg>
                            Cloud Consulting
                        </dt>
                        <dd class="inline">
                            Strategic cloud architecture across AWS, Azure, and GCP—secure, resilient, and cost-efficient platforms designed to scale with your business.
                        </dd>
                    </div>
                    <!-- Cloud Security -->
                    <div class="relative pl-9 max-w-sm w-full sm:w-1/2 lg:w-1/3">
                        <dt class="inline font-semibold text-white">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" data-slot="icon" aria-hidden="true" class="absolute top-1 left-1 size-6 text-brand-primary">
                                <path d="M18.7088 3.49546C16.8165 2.55394 14.5009 2.00012 12 2.00012C9.4991 2.00012 7.1835 2.55394 5.29116 3.49547C4.36318 3.95718 3.89919 4.18804 3.4496 4.91391C3 5.63978 3 6.3426 3 7.74826V11.2372C3 16.9206 7.54236 20.0805 10.173 21.4339C10.9067 21.8114 11.2735 22.0001 12 22.0001C12.7265 22.0001 13.0933 21.8114 13.8269 21.4339C16.4576 20.0805 21 16.9206 21 11.2372L21 7.74827C21 6.34261 21 5.63978 20.5504 4.91391C20.1008 4.18804 19.6368 3.95718 18.7088 3.49546Z" stroke-linecap="round" stroke-linejoin="round"></path>
