---
import "../scripts/main.js";
import Layout from '../layouts/Layout.astro';

import { Image } from 'astro:assets';
import PortraitEmma from "../images/emma.jpg";
import PortraitMichael from "../images/michael.jpg";
import PortraitFloyd from "../images/floyd.jpg";
---
<Layout title="About Us">
    <!-- Hero section -->
    <div class="relative isolate -z-10">
        <svg aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-256 w-full mask-[radial-gradient(32rem_32rem_at_center,white,transparent)] stroke-white/10">
            <defs>
                <pattern id="1f932ae7-37de-4c0a-a8b0-a6e3b4d44b84" width="200" height="200" x="50%" y="-1" patternUnits="userSpaceOnUse">
                    <path d="M.5 200V.5H200" fill="none" />
                </pattern>
            </defs>
            <svg x="50%" y="-1" class="overflow-visible fill-gray-800">
                <path d="M-200 0h201v201h-201Z M600 0h201v201h-201Z M-400 600h201v201h-201Z M200 800h201v201h-201Z" stroke-width="0" />
            </svg>
            <rect width="100%" height="100%" fill="url(#1f932ae7-37de-4c0a-a8b0-a6e3b4d44b84)" stroke-width="0" />
        </svg>
        <div aria-hidden="true" class="absolute top-0 right-0 left-1/2 -z-10 -ml-24 transform-gpu overflow-hidden blur-3xl lg:ml-24 xl:ml-48">
            <div style="clip-path: polygon(63.1% 29.5%, 100% 17.1%, 76.6% 3%, 48.4% 0%, 44.6% 4.7%, 54.5% 25.3%, 59.8% 49%, 55.2% 57.8%, 44.4% 57.2%, 27.8% 47.9%, 35.1% 81.5%, 0% 97.7%, 39.2% 100%, 35.2% 81.4%, 97.2% 52.8%, 63.1% 29.5%)" class="aspect-801/1036 w-200.25 bg-linear-to-tr from-[var(--color-brand-primary-gradient-from)] to-[var(--color-brand-primary-gradient-to)] opacity-30"></div>
        </div>
        <div class="overflow-hidden">
            <div class="mx-auto max-w-7xl px-6 pt-36 pb-32 sm:pt-60 lg:px-8 lg:pt-32">
                <div class="mx-auto max-w-2xl gap-x-14 lg:mx-0 lg:flex lg:max-w-none lg:items-center">
                    <div class="relative w-full lg:max-w-xl lg:shrink-0 xl:max-w-2xl">
                        <h1 class="text-5xl font-semibold tracking-tight text-pretty text-white sm:text-7xl">NoxSecurity — Cyber security for growing organisations</h1>
                        <p class="mt-8 text-lg font-medium text-pretty text-gray-400 sm:max-w-md sm:text-xl/8 lg:max-w-none">
                            We protect small and medium organisations from the threats people don't hear about. Founded by security and product leaders across the Netherlands and the UK, NoxSecurity combines hands-on technical expertise, regulatory know-how and automation to secure cloud infrastructure, supply chains and customer data.
                        </p>
                    </div>
                    <div class="mt-14 flex justify-end gap-8 sm:-mt-44 sm:justify-start sm:pl-20 lg:mt-0 lg:pl-0">
                        <div class="ml-auto w-44 flex-none space-y-8 pt-32 sm:ml-0 sm:pt-80 lg:order-last lg:pt-36 xl:order-0 xl:pt-80">
                            <div class="relative">
                                <img src="https://images.unsplash.com/photo-1557804506-669a67965ba0?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&h=528&q=80" alt="" class="aspect-2/3 w-full rounded-xl bg-gray-700/5 object-cover shadow-lg" />
                                <div class="pointer-events-none absolute inset-0 rounded-xl ring-1 ring-white/10 ring-inset"></div>
                            </div>
                        </div>
                        <div class="mr-auto w-44 flex-none space-y-8 sm:mr-0 sm:pt-52 lg:pt-36">
                            <div class="relative">
                                <img src="https://images.unsplash.com/photo-1485217988980-11786ced9454?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&h=528&q=80" alt="" class="aspect-2/3 w-full rounded-xl bg-gray-700/5 object-cover shadow-lg" />
                                <div class="pointer-events-none absolute inset-0 rounded-xl ring-1 ring-white/10 ring-inset"></div>
                            </div>
                            <div class="relative">
                                <img src="https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&crop=focalpoint&fp-x=.4&w=396&h=528&q=80" alt="" class="aspect-2/3 w-full rounded-xl bg-gray-700/5 object-cover shadow-lg" />
                                <div class="pointer-events-none absolute inset-0 rounded-xl ring-1 ring-white/10 ring-inset"></div>
                            </div>
                        </div>
                        <div class="w-44 flex-none space-y-8 pt-32 sm:pt-0">
                            <div class="relative">
                                <img src="https://images.unsplash.com/photo-1670272504528-790c24957dda?ixlib=rb-4.0.3&ixid=MnwxMjA3fDF8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&crop=left&w=400&h=528&q=80" alt="" class="aspect-2/3 w-full rounded-xl bg-gray-700/5 object-cover shadow-lg" />
                                <div class="pointer-events-none absolute inset-0 rounded-xl ring-1 ring-white/10 ring-inset"></div>
                            </div>
                            <div class="relative">
                                <img src="https://images.unsplash.com/photo-1670272505284-8faba1c31f7d?ixlib=rb-4.0.3&ixid=MnwxMjA3fDF8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&h=528&q=80" alt="" class="aspect-2/3 w-full rounded-xl bg-gray-700/5 object-cover shadow-lg" />
                                <div class="pointer-events-none absolute inset-0 rounded-xl ring-1 ring-white/10 ring-inset"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Content section -->
    <div id="mission" class="mx-auto -mt-12 max-w-7xl px-6 sm:mt-0 lg:px-8 xl:-mt-8">
        <div class="mx-auto max-w-2xl lg:mx-0 lg:max-w-none">
            <h2 class="text-4xl font-semibold tracking-tight text-pretty text-white sm:text-5xl">Our mission</h2>
            <div class="mt-6 flex flex-col gap-x-8 gap-y-20 lg:flex-row">
                <div class="lg:w-full lg:max-w-2xl lg:flex-auto">
                    <p class="text-xl/8 text-gray-300">
                        We exist to make robust cyber security accessible to small and medium organisations. Many SMEs are high-value targets but lack the budget or expertise to build and maintain effective security programs. NoxSecurity delivers pragmatic assessments, tailored remediation and ongoing support so companies can operate with confidence.
                    </p>
                    <p class="mt-10 max-w-xl text-base/7 text-gray-400">
                        Our services cover compliance, security frameworks (e.g. ISO/IEC, NIST), cloud security (AWS, Azure, GCP), threat modelling, supply-chain assurance and penetration testing. We combine expert-led assessments with careful automation to accelerate remediation while preserving governance and safety.
                    </p>
                </div>
                <div class="lg:flex lg:flex-auto lg:justify-center">
                    <dl class="w-64 space-y-8 xl:w-80">
                        <div class="flex flex-col-reverse gap-y-4">
                            <dt class="text-base/7 text-gray-400">Years of combined experience</dt>
                            <dd class="text-5xl font-semibold tracking-tight text-white">20+</dd>
                        </div>
                        <div class="flex flex-col-reverse gap-y-4">
                            <dt class="text-base/7 text-gray-400">Security tools &amp; playbooks</dt>
                            <dd class="text-5xl font-semibold tracking-tight text-white">12+</dd>
                        </div>
                        <div class="flex flex-col-reverse gap-y-4">
                            <dt class="text-base/7 text-gray-400">Research &amp; internal audits</dt>
                            <dd class="text-5xl font-semibold tracking-tight text-white">25+</dd>
                        </div>
                    </dl>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Image section -->
    <div class="mt-32 sm:mt-40 xl:mx-auto xl:max-w-7xl xl:px-8">
        <img src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=2832&q=80" alt="" class="aspect-5/2 w-full object-cover outline-1 -outline-offset-1 outline-white/10 xl:rounded-3xl" />
    </div>
    
    <!-- Feature section -->
    <div id="values" class="mx-auto mt-32 max-w-7xl px-6 sm:mt-40 lg:px-8">
        <div class="mx-auto max-w-2xl lg:mx-0">
            <h2 class="text-4xl font-semibold tracking-tight text-pretty text-white sm:text-5xl">Our values</h2>
            <p class="mt-6 text-lg/8 text-gray-300">Security is practical. We focus on measurable risk reduction, responsible automation and long-term resilience for our clients — not buzzwords.</p>
        </div>
        <dl class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 text-base/7 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3">
            <div>
                <dt class="font-semibold text-white">Protect the unseen</dt>
                <dd class="mt-1 text-gray-400">We prioritise the systems and teams that too often go unprotected — practical, high-impact work for SMEs.</dd>
            </div>
            <div>
                <dt class="font-semibold text-white">Practical remediation</dt>
                <dd class="mt-1 text-gray-400">Every finding comes with a clear, tested remediation plan — and where possible we automate fixes to reduce time-to-remediate.</dd>
            </div>
            <div>
                <dt class="font-semibold text-white">Framework-first</dt>
                <dd class="mt-1 text-gray-400">We align recommendations with recognised frameworks (ISO, NIST, CIS) so you get compliant, repeatable security programs.</dd>
            </div>
            <div>
                <dt class="font-semibold text-white">Client-first</dt>
                <dd class="mt-1 text-gray-400">We partner with engineering and operations teams to deliver solutions that fit existing workflows and constraints.</dd>
            </div>
            <div>
                <dt class="font-semibold text-white">Responsible automation</dt>
                <dd class="mt-1 text-gray-400">We use automation to accelerate remediation, not replace human oversight — governance and safety are always built in.</dd>
            </div>
            <div>
                <dt class="font-semibold text-white">Continuous learning</dt>
                <dd class="mt-1 text-gray-400">We iterate on tools, playbooks and training so clients improve security posture over time, not just for a single report.</dd>
            </div>
        </dl>
    </div>
    
    <!-- Team section -->
    <div id="team" class="mx-auto mt-32 max-w-7xl px-6 sm:mt-48 lg:px-8">
        <div class="mx-auto max-w-2xl lg:mx-0">
            <h2 class="text-4xl font-semibold tracking-tight text-pretty text-white sm:text-5xl">Founders</h2>
            <p class="mt-6 text-lg/8 text-gray-400">A cross-border team combining product, engineering and hands-on security experience to protect practical businesses.</p>
        </div>
        <ul role="list" class="mx-auto mt-16 flex flex-wrap justify-center gap-8 max-w-6xl">
            
            <li class="flex-1 basis-full sm:basis-1/2 lg:basis-1/3 max-w-xs">
                <Image src={PortraitMichael} alt="" class="aspect-3/2 w-full rounded-2xl object-cover object-top outline-1 -outline-offset-1 outline-white/10" />
                <h3 class="mt-6 text-lg/8 font-semibold text-white">Michael Foster</h3>
                <p class="text-base/7 text-gray-400">Founder &amp; CEO — UK</p>
                <p class="mt-4 text-base/7 text-gray-400">Founder with deep experience in cloud security strategy and product-led security services. Michael sets company vision and builds partnerships that scale impact for SMEs.</p>
                <ul role="list" class="mt-6 flex gap-x-6">
                    <!-- Social links -->
                    <li>
                        <a href="#" class="text-gray-400 hover:text-gray-300">
                            <span class="sr-only">X</span>
                            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
                                <path d="M11.4678 8.77491L17.2961 2H15.915L10.8543 7.88256L6.81232 2H2.15039L8.26263 10.8955L2.15039 18H3.53159L8.87581 11.7878L13.1444 18H17.8063L11.4675 8.77491H11.4678ZM9.57608 10.9738L8.95678 10.0881L4.02925 3.03974H6.15068L10.1273 8.72795L10.7466 9.61374L15.9156 17.0075H13.7942L9.57608 10.9742V10.9738Z" />
                            </svg>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="text-gray-400 hover:text-gray-300">
                            <span class="sr-only">LinkedIn</span>
                            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
                                <path d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z" clip-rule="evenodd" fill-rule="evenodd" />
                            </svg>
                        </a>
                    </li>
                </ul>
            </li>
            
            <li class="flex-1 basis-full sm:basis-1/2 lg:basis-1/3 max-w-xs">
                <Image src={PortraitEmma} alt="" class="aspect-3/2 w-full rounded-2xl object-cover object-top outline-1 -outline-offset-1 outline-white/10" />
                <h3 class="mt-6 text-lg/8 font-semibold text-white">Emma Dorsey</h3>
                <p class="text-base/7 text-gray-400">Co-Founder &amp; CTO</p>
                <p class="mt-4 text-base/7 text-gray-400">Engineering and security lead. Emma focuses on secure architecture, automation and building the engineering capabilities that deliver safe, repeatable remediation at scale.</p>
                <ul role="list" class="mt-6 flex gap-x-6">
                    <!-- Social links -->
                    <li>
                        <a href="#" class="text-gray-400 hover:text-gray-300">
                            <span class="sr-only">X</span>
                            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
                                <path d="M11.4678 8.77491L17.2961 2H15.915L10.8543 7.88256L6.81232 2H2.15039L8.26263 10.8955L2.15039 18H3.53159L8.87581 11.7878L13.1444 18H17.8063L11.4675 8.77491H11.4678ZM9.57608 10.9738L8.95678 10.0881L4.02925 3.03974H6.15068L10.1273 8.72795L10.7466 9.61374L15.9156 17.0075H13.7942L9.57608 10.9742V10.9738Z" />
                            </svg>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="text-gray-400 hover:text-gray-300">
                            <span class="sr-only">LinkedIn</span>
                            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
                                <path d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z" clip-rule="evenodd" fill-rule="evenodd" />
                            </svg>
                        </a>
                    </li>
                </ul>
            </li>
            
            <li class="flex-1 basis-full sm:basis-1/2 lg:basis-1/3 max-w-xs">
                <Image src={PortraitFloyd} alt="" class="aspect-3/2 w-full rounded-2xl object-cover object-[0%_15%] outline-1 -outline-offset-1 outline-white/10" />
                <h3 class="mt-6 text-lg/8 font-semibold text-white">Floyd Miles</h3>
                <p class="text-base/7 text-gray-400">Co-Founder &amp; CCO — UK</p>
                <p class="mt-4 text-base/7 text-gray-400">Floyd Miles is a seasoned cyber security leader with over a decade of experience helping organizations protect their most valuable assets. Cloud security consultant specialising in risk assessments, compliance and supply-chain assurance. Floyd leads client engagements and ensures technical recommendations are practical and effective.</p>
                <ul role="list" class="mt-6 flex gap-x-6">
                    <!-- Social links -->
                    <li>
                        <a href="#" class="text-gray-400 hover:text-gray-300">
                            <span class="sr-only">X</span>
                            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
                                <path d="M11.4678 8.77491L17.2961 2H15.915L10.8543 7.88256L6.81232 2H2.15039L8.26263 10.8955L2.15039 18H3.53159L8.87581 11.7878L13.1444 18H17.8063L11.4675 8.77491H11.4678ZM9.57608 10.9738L8.95678 10.0881L4.02925 3.03974H6.15068L10.1273 8.72795L10.7466 9.61374L15.9156 17.0075H13.7942L9.57608 10.9742V10.9738Z" />
                            </svg>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="text-gray-400 hover:text-gray-300">
                            <span class="sr-only">LinkedIn</span>
                            <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
                                <path d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z" clip-rule="evenodd" fill-rule="evenodd" />
                            </svg>
                        </a>
                    </li>
                </ul>
            </li>
        </ul>
        
    </div>
</Layout>