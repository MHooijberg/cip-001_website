---
import "../scripts/main.js";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Get in touch">
    <div class="relative isolate">
        <!-- Notification Container (fixed position, centered) -->
        <div
            id="notification-container"
            class="fixed top-5 left-1/2 -translate-x-1/2 mt-8 z-50 hidden"
        >
            <div
                id="notification"
                class="rounded-md p-4 outline transform transition-all duration-500 ease-out opacity-0 -translate-y-30"
            >
                <div class="flex items-center">
                    <div class="shrink-0" id="notification-icon"></div>
                    <div class="ml-3">
                        <p
                            class="text-sm font-medium"
                            id="notification-message"
                        >
                            Your message has been sent.
                        </p>
                    </div>
                    <div class="ml-auto pl-3">
                        <button
                            id="notification-dismiss"
                            class="inline-flex rounded-md p-1.5 focus-visible:ring-2 focus-visible:ring-offset-1 focus-visible:outline-none"
                        >
                            <span class="sr-only">Dismiss</span>
                            <svg
                                viewBox="0 0 20 20"
                                fill="currentColor"
                                class="size-5"
                            >
                                <path
                                    d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"
                                ></path>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="mx-auto grid max-w-7xl grid-cols-1 lg:grid-cols-2">
            <div
                class="relative px-6 pt-24 pb-20 sm:pt-32 lg:static lg:px-8 lg:py-32"
            >
                <div class="mx-auto max-w-xl lg:mx-0 lg:max-w-lg">
                    <div
                        class="absolute inset-y-0 left-0 -z-10 w-full overflow-hidden ring-1 ring-white/10 lg:w-1/2"
                    >
                        <svg
                            aria-hidden="true"
                            class="absolute inset-0 size-full mask-[radial-gradient(100%_100%_at_top_right,white,transparent)] stroke-white/10"
                        >
                            <defs>
                                <pattern
                                    id="83fd4e5a-9d52-42fc-97b6-718e5d7ee527"
                                    width="200"
                                    height="200"
                                    x="100%"
                                    y="-1"
                                    patternUnits="userSpaceOnUse"
                                >
                                    <path d="M130 200V.5M.5 .5H200" fill="none"
                                    ></path>
                                </pattern>
                            </defs>
                            <rect
                                width="100%"
                                height="100%"
                                stroke-width="0"
                                class="fill-gray-900"></rect>
                            <svg
                                x="100%"
                                y="-1"
                                class="overflow-visible fill-gray-800/20"
                            >
                                <path
                                    d="M-470.5 0h201v201h-201Z"
                                    stroke-width="0"></path>
                            </svg>
                            <rect
                                width="100%"
                                height="100%"
                                fill="url(#83fd4e5a-9d52-42fc-97b6-718e5d7ee527)"
                                stroke-width="0"></rect>
                        </svg>
                        <div
                            aria-hidden="true"
                            class="absolute top-[calc(100%-13rem)] -left-56 block transform-gpu blur-3xl lg:top-[calc(50%-7rem)] lg:left-[max(-14rem,calc(100%-59rem))]"
                        >
                            <div
                                style="clip-path: polygon(74.1% 56.1%, 100% 38.6%, 97.5% 73.3%, 85.5% 100%, 80.7% 98.2%, 72.5% 67.7%, 60.2% 37.8%, 52.4% 32.2%, 47.5% 41.9%, 45.2% 65.8%, 27.5% 23.5%, 0.1% 35.4%, 17.9% 0.1%, 27.6% 23.5%, 76.1% 2.6%, 74.1% 56.1%)"
                                class="aspect-1155/678 w-288.75 bg-linear-to-br from-[var(--color-brand-primary-gradient-from)] to-[var(--color-brand-primary-gradient-to)] opacity-20"
                            >
                            </div>
                        </div>
                    </div>
                    <h2
                        class="text-4xl font-semibold tracking-tight text-pretty text-white sm:text-5xl"
                    >
                        Get in touch
                    </h2>
                    <p class="mt-6 text-lg/8 text-gray-400">
                        Want to see how NoxSecurity can reduce risk for your
                        business? Contact our sales team for a short,
                        no-obligation conversation. We'll review your priorities
                        (compliance, cloud security, supply-chain or penetration
                        testing), outline practical next steps, and propose a
                        tailored plan. Send an email or use the form on this
                        page — We typically respond within 48 hours.
                    </p>
                    <dl class="mt-10 space-y-4 text-base/7 text-gray-300">
                        <div class="flex gap-x-4">
                            <dt class="flex-none">
                                <span class="sr-only">Email</span>
                                <svg
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    data-slot="icon"
                                    aria-hidden="true"
                                    class="h-7 w-6 text-gray-400"
                                >
                                    <path
                                        d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"></path>
                                </svg>
                            </dt>
                            <dd>
                                <a
                                    href="mailto:sales@mhooijberg.com"
                                    class="hover:text-white"
                                    >sales@mhooijberg.com</a>
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>
            <form
                action="#"
                method="POST"
                class="px-6 pt-20 pb-24 sm:pb-32 lg:px-8 lg:py-34"
            >
                <div class="mx-auto max-w-xl lg:mr-0 lg:max-w-lg">
                    <div
                        class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2"
                    >
                        <div>
                            <label
                                for="first-name"
                                class="block text-sm/6 font-semibold text-white"
                                >First name</label
                            >
                            <div class="mt-2.5">
                                <input
                                    id="first-name"
                                    type="text"
                                    name="firstName"
                                    autocomplete="given-name"
                                    class="block w-full rounded-md bg-white/5 px-3.5 py-2 text-base text-white outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-brand-inverse-primary"
                                    required
                                    placeholder="Julius"
                                />
                            </div>
                        </div>
                        <div>
                            <label
                                for="last-name"
                                class="block text-sm/6 font-semibold text-white"
                                >Last name</label
                            >
                            <div class="mt-2.5">
                                <input
                                    id="last-name"
                                    type="text"
                                    name="lastName"
                                    autocomplete="family-name"
                                    class="block w-full rounded-md bg-white/5 px-3.5 py-2 text-base text-white outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-brand-inverse-primary"
                                    required
                                    placeholder="Caesar"
                                />
                            </div>
                        </div>
                        <div>
                            <label
                                for="email"
                                class="block text-sm/6 font-semibold text-white"
                                >Email</label
                            >
                            <div class="mt-2.5">
                                <input
                                    id="email"
                                    type="email"
                                    name="email"
                                    autocomplete="email"
                                    class="block w-full rounded-md bg-white/5 px-3.5 py-2 text-base text-white outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-brand-inverse-primary"
                                    required
                                    placeholder="emperor@senate.rome"
                                />
                            </div>
                        </div>
                        <div>
                            <label
                                for="phone-number"
                                class="block text-sm/6 font-semibold text-white"
                                >Phone number</label
                            >
                            <div class="mt-2.5">
                                <input
                                    id="phone-number"
                                    type="tel"
                                    name="phoneNumber"
                                    autocomplete="tel"
                                    class="block w-full rounded-md bg-white/5 px-3.5 py-2 text-base text-white outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-brand-inverse-primary"
                                    required
                                    placeholder="+1 (555) 234-5678"
                                />
                            </div>
                        </div>
                        <div class="sm:col-span-2">
                            <label
                                for="company"
                                class="block text-sm/6 font-semibold text-white"
                                >Company</label
                            >
                            <div class="mt-2.5">
                                <input
                                    id="company"
                                    type="text"
                                    name="company"
                                    class="block w-full rounded-md bg-white/5 px-3.5 py-2 text-base text-white outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-brand-inverse-primary"
                                    required
                                    placeholder="Roman Empire Inc."
                                />
                            </div>
                        </div>
                        <div class="sm:col-span-2">
                            <label
                                for="role"
                                class="block text-sm/6 font-semibold text-white"
                                >Role</label
                            >
                            <div class="mt-2.5">
                                <input
                                    id="role"
                                    type="text"
                                    name="role"
                                    class="block w-full rounded-md bg-white/5 px-3.5 py-2 text-base text-white outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-brand-inverse-primary"
                                    required
                                    placeholder="Chief of Strategy"
                                />
                            </div>
                        </div>
                        <div class="sm:col-span-2">
                            <label
                                for="subject"
                                class="block text-sm/6 font-semibold text-white"
                                >Subject</label
                            >
                            <div class="mt-2.5">
                                <input
                                    id="subject"
                                    type="text"
                                    name="subject"
                                    class="block w-full rounded-md bg-white/5 px-3.5 py-2 text-base text-white outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-brand-inverse-primary"
                                    required
                                    placeholder="Need help with implementing a cipher named after me!"
                                />
                            </div>
                        </div>
                        <div class="sm:col-span-2">
                            <label
                                for="message"
                                class="block text-sm/6 font-semibold text-white"
                                >Message</label
                            >
                            <div class="mt-2.5">
                                <textarea
                                    id="message"
                                    name="message"
                                    rows="4"
                                    class="block w-full rounded-md bg-white/5 px-3.5 py-2 text-base text-white outline-1 -outline-offset-1 outline-white/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-brand-inverse-primary"
                                    required
                                    placeholder="I've invented a cipher, I would like to discuss how to implement this into my company to enhance security."
                                ></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="mt-8 flex justify-end">
                        <button
                            type="submit"
                            class="rounded-md bg-brand-inverse-primary px-3.5 py-2.5 text-center text-sm font-semibold text-white shadow-xs hover:bg-brand-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-inverse-primary"
                            >Send message</button
                        >
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Form pre-fill script: -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // Define safe subjects
            const subjectMap = {
                cloud_consulting: "Cloud Consulting",
                cloud_security: "Cloud Security",
                migration_and_optimization:
                    "Cloud Migration & Cost Optimization",
                threat_modelling: "Threat Modelling",
                devsecops: "DevSecOps / DevOps",
                kubernetes: "Kubernetes",
            };

            // Get query param
            const params = new URLSearchParams(window.location.search);
            const subjectKey = params.get("subject");

            if (subjectKey && subjectMap.hasOwnProperty(subjectKey)) {
                const subjectField = document.getElementById("subject");
                if (subjectField) {
                    subjectField.value = `Inquiry about '${subjectMap[subjectKey]}' services`;
                }
            }
        });
    </script>

    <!-- Form handler: -->
    <script>
        import { PUBLIC_AWS_API_GATEWAY_ENDPOINT } from "astro:env/client";
        
        document.addEventListener("DOMContentLoaded", () => {
            const form = document.querySelector("form");
            const focusableSelectors = "input, textarea, select, button";
            const focusableElements = Array.from(
                form.querySelectorAll(focusableSelectors),
            );

            // Loop to next input on Enter
            form.addEventListener("keydown", (e) => {
                if (e.key === "Enter") {
                    const target = e.target;
                    // Allow line breaks in textarea
                    if (target.tagName.toLowerCase() === "textarea") return;

                    // Prevent form submission
                    e.preventDefault();

                    // Find index of current element
                    const currentIndex = focusableElements.indexOf(target);
                    if (currentIndex > -1) {
                        // Focus next element, or loop back to first
                        const nextIndex =
                            (currentIndex + 1) % focusableElements.length;
                        focusableElements[nextIndex].focus();
                    }
                }
            });

            form.addEventListener("submit", async (e) => {
                e.preventDefault(); // prevent default page reload

                const formData = new FormData(form);
                const payload = Object.fromEntries(formData.entries());
                try {
                    const response = await fetch(
                        `https://${PUBLIC_AWS_API_GATEWAY_ENDPOINT}/mail/sent`,
                        {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json",
                            },
                            body: JSON.stringify(payload),
                        },
                    );

                    if (response.ok) {
                        showNotification("Your message has been sent successfully.", "success");
                        // form.reset();
                    } else {
                        if (import.meta.env.MODE === "development") {
                            console.error("Server error:", await response.text());
                        }
                        showNotification("There was a problem sending your message. Please try again.", "error");
                    }
                } catch (err) {
                    if (import.meta.env.MODE === "development") {
                        console.error("Network error:", err);
                    }
                    
                    showNotification("Could not connect to the server. Please try again later.", "error");
                }
            });
        });

        function showNotification(message, type = "success") {
            const container = document.getElementById("notification-container");
            const notification = document.getElementById("notification");
            const messageEl = document.getElementById("notification-message");
            const iconEl = document.getElementById("notification-icon");

            // Reset classes first
            notification.className = "rounded-md p-4 outline transform transition-all duration-500 ease-out opacity-0 -translate-y-10";

            // Define color and icon based on type
            let bgClass, outlineClass, textColor, iconSVG;

            if (type === "error") {
                bgClass = "bg-red-500/15";
                outlineClass = "outline-red-500/25";
                textColor = " text-red-200";
                iconSVG = `
      <svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="size-5 text-red-400">
        <path d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM8.28 7.22a.75.75 0 0 0-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 1 0 1.06 1.06L10 11.06l1.72 1.72a.75.75 0 1 0 1.06-1.06L11.06 10l1.72-1.72a.75.75 0 0 0-1.06-1.06L10 8.94 8.28 7.22Z" clip-rule="evenodd" fill-rule="evenodd" />
      </svg>`;
            } else {
                // Success (default)
                bgClass = "bg-green-500/10";
                outlineClass = "outline-green-500/20";
                textColor = "text-green-300";
                iconSVG = `
      <svg viewBox="0 0 20 20" fill="currentColor" class="size-5 text-green-400">
        <path fill-rule="evenodd" clip-rule="evenodd"
          d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" />
      </svg>`;
            }

            // Apply styles
            notification.classList.add(bgClass, outlineClass);
            messageEl.className = `text-sm font-medium ${textColor}`;
            iconEl.innerHTML = iconSVG;

            messageEl.textContent = message;
            container.classList.remove("hidden");

            // Animate in
            requestAnimationFrame(() => {
                notification.classList.remove("opacity-0", "-translate-y-30");
                notification.classList.add("opacity-100", "translate-y-0");
            });

            // Auto-hide after 5 seconds
            setTimeout(() => hideNotification(), 5000);
        }

        function hideNotification() {
            const container = document.getElementById("notification-container");
            const notification = document.getElementById("notification");

            notification.classList.remove("opacity-100", "translate-y-0");
            notification.classList.add("opacity-0", "-translate-y-30");

            setTimeout(() => {
                container.classList.add("hidden");
            }, 500);
        }

        document
            .getElementById("notification-dismiss")
            .addEventListener("click", hideNotification);
    </script>
</Layout>
