                                </svg>
                            </div>
                        </li>
                        <li class="relative flex gap-x-6 py-6">
                            <div class="flex size-10 flex-none items-center justify-center rounded-lg bg-gray-800/50 shadow-xs outline-1 -outline-offset-1 outline-white/10">
                                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-6 text-brand-primary group-hover:text-white">
                                    <path d="M7.84 1.804A1 1 0 0 1 8.82 1h2.36a1 1 0 0 1 .98.804l.331 1.652a6.993 6.993 0 0 1 1.929 1.115l1.598-.54a1 1 0 0 1 1.186.447l1.18 2.044a1 1 0 0 1-.205 1.251l-1.267 1.113a7.047 7.047 0 0 1 0 2.228l1.267 1.113a1 1 0 0 1 .206 1.25l-1.18 2.045a1 1 0 0 1-1.187.447l-1.598-.54a6.993 6.993 0 0 1-1.929 1.115l-.33 1.652a1 1 0 0 1-.98.804H8.82a1 1 0 0 1-.98-.804l-.331-1.652a6.993 6.993 0 0 1-1.929-1.115l-1.598.54a1 1 0 0 1-1.186-.447l-1.18-2.044a1 1 0 0 1 .205-1.251l1.267-1.114a7.05 7.05 0 0 1 0-2.227L1.821 7.773a1 1 0 0 1-.206-1.25l1.18-2.045a1 1 0 0 1 1.187-.447l1.598.54A6.992 6.992 0 0 1 7.51 3.456l.33-1.652ZM10 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" clip-rule="evenodd" fill-rule="evenodd"/>
                                </svg>
                            </div>
                            <div class="flex-auto">
                                <h3 class="text-sm/6 font-semibold text-white">
                                    <a href="/services.html">
                                        <span aria-hidden="true" class="absolute inset-0"></span>
                                        Compliance Audit
                                    </a>
                                </h3>
                                <p class="mt-2 text-sm/6 text-gray-400">Assess controls, policies and tech measures to help you meet industry regulations and pass audits.</p>
                            </div>
                            <div class="flex-none self-center">
                                <svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="size-5 text-gray-500">
