---
import "../scripts/main.js";
import Layout from '../layouts/Layout.astro';
---
<Layout title="Error">
    <section id="error">
            <main class="mx-auto w-full max-w-7xl px-6 pt-10 pb-16 sm:pb-24 lg:px-8">
                <div class="mx-auto mt-20 max-w-2xl text-center sm:mt-24">
                    <p class="text-base/8 font-semibold text-brand-primary text-5xl sm:text-6xl">404</p>
                    <h1 class="mt-4 text-5xl font-semibold tracking-tight text-balance text-white sm:text-6xl">This page does not exist</h1>
                    <p class="mt-6 text-lg font-medium text-pretty text-gray-400 sm:text-xl/8">Sorry, we couldn't find the page you're looking for.</p>
                </div>
                <div class="mx-auto mt-16 flow-root max-w-lg sm:mt-20">
                    <h2 class="sr-only">Popular pages</h2>
                    
                    <ul role="list" class="-mt-6 divide-y divide-white/10 border-b border-white/10">
                        <li class="relative flex gap-x-6 py-6">
                            <div class="flex size-10 flex-none items-center justify-center rounded-lg bg-gray-800/50 shadow-xs outline-1 -outline-offset-1 outline-white/10">
                                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-6 text-brand-primary group-hover:text-white">
                                    <path d="M5.5 17a4.5 4.5 0 0 1-1.44-8.765 4.5 4.5 0 0 1 8.302-3.046 3.5 3.5 0 0 1 4.504 4.272A4 4 0 0 1 15 17H5.5Zm3.75-2.75a.75.75 0 0 0 1.5 0V9.66l1.95 2.1a.75.75 0 1 0 1.1-1.02l-3.25-3.5a.75.75 0 0 0-1.1 0l-3.25 3.5a.75.75 0 1 0 1.1 1.02l1.95-2.1v4.59Z" clip-rule="evenodd" fill-rule="evenodd"/>
                                </svg>
                            </div>
                            <div class="flex-auto">
                                <h3 class="text-sm/6 font-semibold text-white">
                                    <a href="/services.html">
                                        <span aria-hidden="true" class="absolute inset-0"></span>
                                        Cloud &amp; Cloud Security Audits
                                    </a>
                                </h3>
                                <p class="mt-2 text-sm/6 text-gray-400">Uncover vulnerabilities and misconfigurations in your cloud environments with actionable recommendations.</p>
                            </div>
                            <div class="flex-none self-center">
                                <svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="size-5 text-gray-500">
                                    <path d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd" />
                                </svg>
                            </div>
                        </li>
                        <li class="relative flex gap-x-6 py-6">
                            <div class="flex size-10 flex-none items-center justify-center rounded-lg bg-gray-800/50 shadow-xs outline-1 -outline-offset-1 outline-white/10">
                                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-6 text-brand-primary group-hover:text-white">
                                    <path d="M10 1a4.5 4.5 0 0 0-4.5 4.5V9H5a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2h-.5V5.5A4.5 4.5 0 0 0 10 1Zm3 8V5.5a3 3 0 1 0-6 0V9h6Z" clip-rule="evenodd" fill-rule="evenodd"/>
                                </svg>
                            </div>
                            <div class="flex-auto">
                                <h3 class="text-sm/6 font-semibold text-white">
                                    <a href="/services.html">
                                        <span aria-hidden="true" class="absolute inset-0"></span>
                                        Threat Modeling
                                    </a>
                                </h3>
                                <p class="mt-2 text-sm/6 text-gray-400">Identify, prioritize, and mitigate risks before attackers do — tailored to your systems and processes.</p>
                            </div>
                            <div class="flex-none self-center">
                                <svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="size-5 text-gray-500">
                                    <path d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd" />
