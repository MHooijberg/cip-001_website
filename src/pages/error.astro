                                </svg>
                            </div>
                        </li>
                    </ul>
                    <div class="mt-10 flex justify-center">
                        <a href="/" class="text-sm/6 font-semibold text-brand-primary"><span aria-hidden="true">&larr;</span> Back to home</a>
                    </div>
                </div>
            </main>
    </section>
</Layout>